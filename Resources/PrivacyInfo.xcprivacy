<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entrain has no network layer, no analytics and no third-party SDK, so
	     there is nothing to track with and nothing to track to. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Deliberately empty. Sleep, heart rate, variability, daylight and
	     mindful minutes are read from Health and written back to it on the
	     device; the day, the session log and the settings live in this app's
	     own defaults. None of it is collected, because none of it leaves. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<!-- CA92.1: defaults readable and writable only by this app.
			     Every access is UserDefaults.standard; nothing reads a suite
			     or an App Group's defaults, so 1C8F.1 does not apply. The App
			     Group the iPhone and Watch declare carries the widget
			     snapshot as a file, not as defaults. -->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
