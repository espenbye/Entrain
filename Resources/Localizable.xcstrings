          }
        }
      }
    },
    "Why this works": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor det virker"
          }
        }
      }
    },
    "Wind Down": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro ned"
          }
        }
      }
    },
    "Wind Down opens three hours before this bedtime and Wake covers the two hours before this wake. Entrain moves toward it about twenty minutes a night from the sleep it measures, because a body clock will not jump.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Roe ned åpner tre timer før denne leggetiden, og Våkne dekker de to timene før du står opp. Entrain flytter seg mot målet omtrent tjue minutter per natt fra søvnen den måler, fordi en døgnrytme ikke lar seg flytte i ett byks."
          }
        }
      }
    },
    "Wind-Down Window": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedtrappingsvinduet"
          }
        }
      }
    },
