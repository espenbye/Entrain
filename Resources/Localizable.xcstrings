      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sover vanligvis"
          }
        }
      }
    },
    "You are sleeping the night you are aiming for.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sover natten du sikter mot."
