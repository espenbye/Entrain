    "4 in, 6 out. A longer exhale for calm." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 inn, 6 ut. Lengre utpust for ro."
          }
        }
      }
    },
    "4 in, hold 4, 4 out, hold 4. Steadies attention." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 inn, hold 4, 4 ut, hold 4. Stabiliserer oppmerksomheten."
          }
        }
      }
    },
    "4 in, hold 7, 8 out. Slows the body down." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 inn, hold 7, 8 ut. Roer ned kroppen."
          }
        }
      }
    },
    "4-7-8" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4-7-8"
          }
        }
      }
    },
    "5 in, 5 out. Six breaths a minute, the resonance rate." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 inn, 5 ut. Seks pust i minuttet, resonansfrekvensen."
